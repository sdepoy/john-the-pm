// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Teams ────────────────────────────────────────────────────────────────────

model Team {
  id          String       @id @default(cuid())
  name        String
  members     TeamMember[]
  projects    Project[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  // "admin" | "member"
  role     String   @default("member")
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id        String  @id @default(cuid())
  teamId    String
  name      String
  objective String?
  // "discovery" | "draft" | "active" | "complete" | "archived"
  // One active project per team enforced at application level — NOT a unique constraint
  // so v2 multi-project support requires no migration.
  status    String  @default("discovery")
  // Shared project context injected into every system prompt: decisions, risks, blockers
  context   Json    @default("{}")
  // Full structured plan artifact generated from discovery
  plan      Json?
  // Optimistic locking version counter
  version   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  tasks      Task[]
  threads    Thread[]

  @@index([teamId])
  @@index([teamId, status])
}

// ─── Milestones ───────────────────────────────────────────────────────────────

model Milestone {
  id         String    @id @default(cuid())
  projectId  String
  title      String
  targetDate DateTime?
  // "not_started" | "in_progress" | "at_risk" | "complete"
  status     String    @default("not_started")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

// ─── Tasks ────────────────────────────────────────────────────────────────────
// content_hash is a GENERATED ALWAYS AS STORED computed column added via raw SQL
// in the initial migration (Prisma cannot model this in schema.prisma).
// Formula: md5(lower(title)||'::'||project_id::text||'::'||COALESCE(milestone_id::text,''))
// A UNIQUE index on content_hash prevents duplicate tasks across concurrent conversations.

model Task {
  id          String    @id @default(cuid())
  projectId   String
  milestoneId String?
  title       String
  description String?
  // null = unassigned
  assigneeId  String?
  // "unassigned" | "assigned" | "in_progress" | "blocked" | "complete"
  status      String    @default("unassigned")
  // "critical" | "high" | "medium" | "low"
  priority    String    @default("medium")
  // Task IDs this task depends on (must be complete before this task is actionable)
  dependsOn   String[]  @default([])
  dueDate     DateTime?
  // Set when status = "blocked"
  blockerNote String?
  // Optimistic locking for task status updates
  version     Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, status])
  @@index([assigneeId])
}

// ─── Conversation Threads ─────────────────────────────────────────────────────

model Thread {
  id        String @id @default(cuid())
  projectId String
  userId    String

  // LLM-generated rolling summary (strips project state facts — those reload fresh each request)
  summary   String?
  // Message count at time of last summarization (used to track condensation)
  summaryAt Int?
  // Pending write proposal awaiting user confirmation (null if none pending)
  pendingProposal Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Message {
  id         String  @id @default(cuid())
  threadId   String
  // "user" | "assistant" | "tool"
  role       String
  // Full AI SDK message parts array stored as JSON
  content    Json
  tokenCount Int?
  // Summarized messages excluded from context assembly but retained for history display
  summarized Boolean @default(false)

  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([threadId, summarized])
}

// ─── Invitations ──────────────────────────────────────────────────────────────

model Invitation {
  id         String    @id @default(cuid())
  teamId     String
  email      String
  // Stored as a hashed token; raw token emailed to invitee
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, email])
}

// ─── Auth.js v5 Required Models ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  teamMembers TeamMember[]
  threads     Thread[]
  tasks       Task[]       @relation("TaskAssignee")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  // Cached team context to avoid a per-request DB lookup for role/teamId
  teamId       String?
  teamRole     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
